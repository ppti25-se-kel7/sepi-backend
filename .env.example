# Salin file ini menjadi .env lalu isi dengan nilai asli. File .env tidak boleh di-commit.

# Connection string dari dashboard Neon. Ganti awalan "postgresql://" menjadi "postgresql+psycopg://"
DATABASE_URL=postgresql+psycopg://user:password@host.neon.tech/dbname?sslmode=require

# Project ID Firebase (Firebase console → Project settings → General). Kosong = login belum aktif.
FIREBASE_PROJECT_ID=

# Opsional: alamat Flutter web yang boleh memanggil API, dipisah koma (localhost sudah otomatis diizinkan)
# CORS_ORIGINS=https://sepi.example.com,https://www.sepi.example.com
